{
  "name": "veil",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "rm -rf .next && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "npm run verify:demo && npm run typecheck && npm test && npm run test:privacy && npm run prove:midnight && npm run build:clean",
    "verify:demo": "tsx scripts/verify-demo.ts",
    "verify:live": "tsx scripts/verify-live-app.ts",
    "prove:midnight": "tsx scripts/prove-midnight-private-verification.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:privacy": "vitest run test/midnight-private-verification.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
